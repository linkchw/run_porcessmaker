# Use a unique name when multiple deployments share one Docker host.
COMPOSE_PROJECT_NAME=rashen-processmaker

# Keep 127.0.0.1 when a host reverse proxy provides HTTPS.
# Use 0.0.0.0 only for intentional direct access protected by a firewall.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# MySQL is published on localhost by default for SSH-tunneled administration.
# Set DB_BIND_IP=0.0.0.0 only when both the provider firewall and host firewall
# restrict DB_PORT to the administrator's fixed public IP.
DB_BIND_IP=127.0.0.1
DB_PORT=3306

# Set these to the address users enter in their browser.
PM_PUBLIC_HOST=processmaker.example.com
PM_PUBLIC_PORT=443

PM_WORKSPACE=workflow
PM_DB_NAME=workflow
PM_ADMIN_USER=admin
PM_DEFAULT_LANG=fa
PHP_DATE_TIMEZONE=Asia/Tehran
